// REQUIRES: qemu-available
// REQUIRES: aarch64-registered-target

// 1. Compile the binary automatically using the specified parameters.
// RUN: %clangxx -x c++ -fno-emulated-tls -fsanitize=hwaddress --target=aarch64-linux-ohos -g -O1 --sysroot=%S/sysroot -Wl,--build-id %s -o %t_bin

// 2. Execute the binary using QEMU to trigger HWASan crash, saving raw output to a temporary file.
// Note: 'not' is used because the program is expected to crash and return a non-zero exit code.
// RUN: not qemu-aarch64 -L %S/sysroot/aarch64-linux-ohos/usr/ -E LD_LIBRARY_PATH=%S/BiSheng/lib/aarch64-linux-ohos -E HWASAN_SYMBOLIZER_PATH=%S/BiSheng/bin/llvm-symbolizer -E HWASAN_OPTIONS="symbolize=0:halt_on_error=1" %t_bin > %t_raw.log 2>&1

// 3. Filter out irrelevant logs (e.g., HiLogAdapter_init) to generate the final hwasan.log.
// RUN: grep -v "HiLogAdapter_init" %t_raw.log > %t_hwasan.log || true

// 4. Invoke llvm-objdump to parse the compiled binary and the filtered log, then verify with FileCheck.
// RUN: llvm-objdump -d %t_bin --crash-snapshot=%t_hwasan.log 2>&1 | FileCheck %s


// CHECK: === Crash Snapshot Target ===
// CHECK: Operation: WRITE
// CHECK: Fault Address: 0x{{[0-9a-f]+}}
// CHECK: Access Size: 4

// CHECK: === Registers ===
// CHECK: sp: 0x{{[0-9a-f]+}}
// CHECK: pc: 0x{{[0-9a-f]+}}

// CHECK: === Stack Frames ===
// CHECK: #0 runtime pc: 0x{{[0-9a-f]+}}{{.*}}module: {{.*}}{{.*}}static pc: 0x{{[0-9a-f]+}}{{.*}}load bias: 0x{{[0-9a-f]+}}

// CHECK: <result>
// CHECK-NEXT: <--- [CRASH ROOT CAUSE HERE]
// CHECK-NEXT: <--- RUNNING PC: 0x{{[0-9a-fA-F]+}}
// CHECK-NEXT: DWARF Active Variables:
// CHECK-NEXT: ========== DWARF POSITIONING MODULE ==========
// CHECK-NEXT: Target Crash PC: 0x{{[0-9a-f]+}}
// CHECK-NEXT: Found Function: level3_crash
// CHECK-NEXT: Active Variables at Crash Moment:
// CHECK-NEXT: {{.*}}[Parameter] Name: ptr{{.*}}Location: Register ({{.*}})
// CHECK-NEXT: {{.*}}[Parameter] Name: index{{.*}}Location: Register ({{.*}})
// CHECK-NEXT: ==============================================

#include <iostream>
#include <vector>
#include <cstring>

// Level 3: Function to trigger stack buffer overflow
void level3_crash(int *ptr, int index) {
    std::cout << "  [Level 3] Target Out-of-Bounds Index: " << index << std::endl;
    // Trigger out-of-bounds write
    ptr[index] = 0xDEADBEEF;
    std::cout << "  [Level 3] Triggering illegal write (Program should crash here)" << std::endl;
}

// Level 2: Intermediate processing layer
void level2_process(int *buffer, int size) {
    std::cout << "[Level 2] Current buffer size: " << size << std::endl;
    int bad_index = size + 5;
    level3_crash(buffer, bad_index);
}

// Level 1: Initialization layer
void level1_init() {
    std::cout << "[Level 1] Initializing buffer..." << std::endl;
    const int size = 5;
    int my_buffer[size] = {1, 2, 3, 4, 5};
    level2_process(my_buffer, size);
}

int main() {
    std::cout << "--- Stack Buffer Overflow Vulnerability Test ---" << std::endl;
    level1_init();
    return 0;
}